    "why_silk": {
      "type": "hushhh-why-silk",
      "blocks": {
        "fact-1": {
          "type": "fact",
          "settings": {
            "title": "Better for your skin",
            "body": "Silk draws far less moisture out of the skin than cotton, so the serum you put on at night stays on your face — and the smooth surface leaves no sleep creases behind."
          }
        },
        "fact-2": {
          "type": "fact",
          "settings": {
            "title": "Better for your hair",
            "body": "A smoother fibre means less tugging while you move, so hair keeps its shape: fewer tangles, less frizz and fewer split ends by morning."
          }
        },
        "fact-3": {
          "type": "fact",
          "settings": {
            "title": "Better temperature control",
            "body": "Silk carries heat away from the body instead of holding it, and insulates once the night cools down. Cool in an Australian February, warm in July."
          }
        }
      },
      "block_order": [
        "fact-1",
        "fact-2",
        "fact-3"
      ],
