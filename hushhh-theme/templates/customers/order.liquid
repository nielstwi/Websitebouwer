<div class="page-content">
  <h1>{{ 'customer.orders.order_number' | t }} {{ order.name }}</h1>
  <a href="{{ routes.account_url }}">&larr; {{ 'customer.account.return' | t }}</a>

  <table class="account-orders-table" style="margin-top:20px;">
    <thead><tr><th>Product</th><th>Price</th><th>Qty</th><th>Total</th></tr></thead>
    <tbody>
      {% for line_item in order.line_items %}
        <tr>
          <td>{{ line_item.title }}</td>
          <td>{{ line_item.original_price | money }}</td>
          <td>{{ line_item.quantity }}</td>
          <td>{{ line_item.final_line_price | money }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

  <p style="margin-top:16px;"><strong>{{ 'customer.orders.total' | t }}:</strong> {{ order.total_price | money }}</p>
  <p><strong>{{ 'customer.orders.fulfillment_status' | t }}:</strong> {{ order.fulfillment_status_label }}</p>
</div>
