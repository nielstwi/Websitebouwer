{% comment %}
  Renders one product card.
  Accepts: product (object), card_product_image_fallback (string, optional asset filename
  used when the product has no image — keeps demo/sample products looking finished).
{% endcomment %}
{% assign featured_image = product.featured_image | default: card_product_image_fallback %}
{% assign second_image = product.images[1] %}

<div class="product-card">
  <a href="{{ product.url | default: '#' }}" class="product-card__media">
    <div class="product-card__badges">
      {% if product.compare_at_price > product.price and settings.show_sale_badge %}
        {% assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
        <span class="badge badge--sale">-{{ discount }}%</span>
      {% endif %}
      {% if product.tags contains 'new' %}<span class="badge">New</span>{% endif %}
      {% unless product.available %}<span class="badge">Sold out</span>{% endunless %}
    </div>
    {% if featured_image != blank %}
      {% if product.featured_image %}
        <img src="{{ featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}" loading="lazy" width="700" height="933">
      {% else %}
        <img src="{{ featured_image | asset_url }}" alt="{{ product.title | escape }}" loading="lazy" width="700" height="933">
      {% endif %}
    {% endif %}
    {% if second_image %}
      <img class="product-card__image--back" src="{{ second_image | image_url: width: 700 }}" alt="" loading="lazy" width="700" height="933">
    {% endif %}
    {% if settings.enable_quick_add and product.selected_or_first_available_variant %}
      <div class="product-card__quick-add">
        {% form 'product', product, data-add-to-cart-form: '' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="btn btn--white btn--small btn--full" {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}
          </button>
        {% endform %}
      </div>
    {% endif %}
  </a>
  <div class="product-card__info">
    {% if settings.show_vendor and product.vendor != blank %}
      <div class="product-card__vendor">{{ product.vendor }}</div>
    {% endif %}
    <div class="product-card__title"><a href="{{ product.url | default: '#' }}">{{ product.title | default: 'Product title' }}</a></div>
    <div class="product-card__price">
      {% if product.compare_at_price > product.price %}
        <span class="price--sale">{{ product.price | money }}</span>
        <span class="compare-at">{{ product.compare_at_price | money }}</span>
      {% else %}
        <span>{{ product.price | default: 0 | money }}</span>
      {% endif %}
    </div>
    {% if settings.show_color_swatches and product.options contains 'Color' %}
      <div class="swatches">
        {% for variant in product.variants limit: 6 %}
          <span class="swatch" style="background: {{ variant.option2 | default: variant.option1 | handle }};" title="{{ variant.title }}"></span>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>
