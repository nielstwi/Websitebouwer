{% comment %}
  Renders a product-style card from manual block settings (no real Shopify product required).
  Used by featured-collection.liquid when no collection is assigned yet, so the section still
  shows finished, on-brand content out of the box. Swap to a real collection any time — the
  section then renders live products via snippets/product-card.liquid instead.
  Expects: title, price, compare_at_price, vendor, link, image, image_fallback, badge
{% endcomment %}
<div class="product-card">
  <a href="{{ link | default: '#' }}" class="product-card__media">
    <div class="product-card__badges">
      {% if compare_at_price != blank and compare_at_price > price and settings.show_sale_badge %}
        {% assign discount = compare_at_price | minus: price | times: 100 | divided_by: compare_at_price %}
        <span class="badge badge--sale">-{{ discount }}%</span>
      {% endif %}
      {% if badge != blank %}<span class="badge">{{ badge }}</span>{% endif %}
    </div>
    {% if image %}
      <img src="{{ image | image_url: width: 700 }}" alt="{{ title | escape }}" loading="lazy" width="700" height="933">
    {% elsif image_fallback %}
      <img src="{{ image_fallback | asset_url }}" alt="{{ title | escape }}" loading="lazy" width="700" height="933">
    {% endif %}
  </a>
  <div class="product-card__info">
    {% if settings.show_vendor and vendor != blank %}<div class="product-card__vendor">{{ vendor }}</div>{% endif %}
    <div class="product-card__title"><a href="{{ link | default: '#' }}">{{ title }}</a></div>
    <div class="product-card__price">
      {% if compare_at_price != blank and compare_at_price > price %}
        <span class="price--sale">{{ price | times: 100 | money }}</span>
        <span class="compare-at">{{ compare_at_price | times: 100 | money }}</span>
      {% else %}
        <span>{{ price | times: 100 | money }}</span>
      {% endif %}
    </div>
  </div>
</div>
