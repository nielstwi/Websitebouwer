<div class="section-padding">
  <div class="container">
    <div class="section-heading-row">
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="ugc-gallery">
      {% for block in section.blocks %}
        {% if block.type == 'image' %}
          <a href="{{ block.settings.link | default: '#' }}" class="ugc-gallery__item" {{ block.shopify_attributes }}>
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 500 }}" alt="" loading="lazy" width="500" height="667">
            {% elsif block.settings.image_fallback %}
              <img src="{{ block.settings.image_fallback | asset_url }}" alt="" loading="lazy" width="500" height="667">
            {% endif %}
            {% if block.settings.show_play_icon %}<span class="ugc-gallery__play">&#9654;</span>{% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "UGC image gallery",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sleep Beautifully" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_fallback", "label": "Fallback image (theme asset filename)" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "show_play_icon", "label": "Show video play icon", "default": false }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "image", "settings": { "image_fallback": "gallery-1.jpg", "show_play_icon": true } },
      { "type": "image", "settings": { "image_fallback": "gallery-2.jpg" } },
      { "type": "image", "settings": { "image_fallback": "gallery-3.jpg", "show_play_icon": true } },
      { "type": "image", "settings": { "image_fallback": "gallery-4.jpg" } },
      { "type": "image", "settings": { "image_fallback": "gallery-5.jpg" } }
    ]
  },
  "presets": [
    { "name": "UGC image gallery" }
  ]
}
{% endschema %}
