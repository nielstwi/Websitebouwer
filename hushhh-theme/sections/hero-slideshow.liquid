<div class="hero-slideshow" data-hero-slideshow data-autoplay="{{ section.settings.autoplay }}" data-autoplay-speed="{{ section.settings.autoplay_speed }}">
  <div class="hero-slideshow__track" data-slideshow-track>
    {% assign slide_fallbacks = 'hero-1-clearance.jpg,hero-2-scallop.jpg,hero-3-pointelle.jpg' | split: ',' %}
    {% assign slide_index = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'slide' %}
        <div class="hero-slide" data-slide {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            <img src="{{ block.settings.image | image_url: width: 2000 }}" alt="{{ block.settings.title | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" width="2000" height="1000">
          {% else %}
            {% assign fallback = slide_fallbacks[slide_index] | default: slide_fallbacks[0] %}
            <img src="{{ fallback | asset_url }}" alt="{{ block.settings.title | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" width="2000" height="1000">
          {% endif %}
          <div class="hero-slide__content">
            {% if block.settings.eyebrow != blank %}<div class="hero-slide__eyebrow">{{ block.settings.eyebrow }}</div>{% endif %}
            <h1 class="hero-slide__title">{{ block.settings.title }}</h1>
            {% if block.settings.description != blank %}<p class="hero-slide__desc">{{ block.settings.description }}</p>{% endif %}
            {% if block.settings.button_label != blank %}
              <a href="{{ block.settings.button_link | default: '#' }}" class="btn btn--white btn--long">{{ block.settings.button_label }}</a>
            {% endif %}
          </div>
        </div>
        {% assign slide_index = slide_index | plus: 1 %}
      {% endif %}
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <button class="hero-slideshow__arrow hero-slideshow__arrow--prev" data-slide-prev aria-label="Previous slide">&#8249;</button>
    <button class="hero-slideshow__arrow hero-slideshow__arrow--next" data-slide-next aria-label="Next slide">&#8250;</button>
    <div class="hero-slideshow__dots">
      {% for block in section.blocks %}
        {% if block.type == 'slide' %}
          <button data-slide-dot aria-label="Go to slide {{ forloop.index }}"></button>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Hero slideshow",
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "autoplay_speed", "min": 3000, "max": 8000, "step": 500, "unit": "ms", "label": "Autoplay speed", "default": 5000 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow text (small text above title)", "default": "End of Summer Clearance" },
        { "type": "text", "id": "title", "label": "Title", "default": "Last Chance For These Items" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Limited stock available. Ends August 31st." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop The Sale" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "slide",
        "settings": {
          "eyebrow": "End of Summer Clearance",
          "title": "Last Chance For These Items",
          "description": "Limited stock available. Ends August 31st.",
          "button_label": "Shop The Sale"
        }
      },
      {
        "type": "slide",
        "settings": {
          "eyebrow": "New In",
          "title": "The Scallop Collection",
          "description": "One collection, two fabrics. Silk and TENCEL™ sleepwear, sleep masks, and pillowcases. Each finished with a delicate scallop edge.",
          "button_label": "Shop Scallop"
        }
      },
      {
        "type": "slide",
        "settings": {
          "title": "The Pointelle Collection",
          "description": "Featuring a mix of easy-to-wear shapes to lounge, layer and sleep in. This is comfort that feels as good as it looks.",
          "button_label": "Shop Pointelle"
        }
      }
    ]
  },
  "presets": [
    { "name": "Hero slideshow" }
  ]
}
{% endschema %}
