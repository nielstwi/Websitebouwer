{%- comment -%}
  #hushhhnights social/UGC image grid, matching the mockup's homepage block.
{%- endcomment -%}

<div class="hushhh-section color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="hushhh-ugc__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="h1">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link_url | default: '#' }}" class="link hushhh-ugc__all">
          {{ section.settings.link_label | escape }}
        </a>
      {%- endif -%}
    </div>
    <div class="hushhh-ugc__grid">
      {%- for block in section.blocks -%}
        <div class="hushhh-ugc__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 16vw, 33vw' }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
.hushhh-ugc__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 2rem;
  flex-wrap: wrap;
  padding: 6.4rem 0 2.6rem;
}
.hushhh-ugc__all {
  border-bottom: 1px solid var(--hushhh-divider-strong);
  padding-bottom: 0.3rem;
  text-decoration: none;
}
.hushhh-ugc__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.2rem;
  padding-bottom: 6.4rem;
}
.hushhh-ugc__item {
  aspect-ratio: 1;
  background: var(--hushhh-surface);
  overflow: hidden;
}
.hushhh-ugc__item img,
.hushhh-ugc__item svg,
.hushhh-ugc__item .placeholder-svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
@media screen and (min-width: 750px) {
  .hushhh-ugc__grid {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }
  .hushhh-ugc__head {
    padding: 6.4rem 4.8rem 2.6rem;
  }
  .hushhh-ugc__grid {
    padding: 0 4.8rem 6.4rem;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "HUSHHH — UGC gallery",
  "class": "hushhh-ugc-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "#hushhhnights" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Follow along" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "HUSHHH — UGC gallery",
      "blocks": [
        { "type": "image" }, { "type": "image" }, { "type": "image" },
        { "type": "image" }, { "type": "image" }, { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
