<div class="section-padding">
  <div class="container">
    <div class="section-heading-row">
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.link != blank %}<a class="view-all" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>{% endif %}
    </div>
    <div class="social-gallery__grid">
      {% for block in section.blocks %}
        {% if block.type == 'image' %}
          <a href="{{ block.settings.link | default: '#' }}" class="social-gallery__item" {{ block.shopify_attributes }}>
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 400 }}" alt="" loading="lazy" width="400" height="400">
            {% elsif block.settings.image_fallback %}
              <img src="{{ block.settings.image_fallback | asset_url }}" alt="" loading="lazy" width="400" height="400">
            {% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Social gallery",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "#pillowtalk with @hushhh" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop Now" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_fallback", "label": "Fallback image (theme asset filename)" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "image", "settings": { "image_fallback": "pillowtalk-1.jpg" } },
      { "type": "image", "settings": { "image_fallback": "pillowtalk-2.jpg" } },
      { "type": "image", "settings": { "image_fallback": "pillowtalk-3.jpg" } },
      { "type": "image", "settings": { "image_fallback": "pillowtalk-4.jpg" } },
      { "type": "image", "settings": { "image_fallback": "pillowtalk-5.jpg" } },
      { "type": "image", "settings": { "image_fallback": "pillowtalk-6.jpg" } },
      { "type": "image", "settings": { "image_fallback": "pillowtalk-7.jpg" } },
      { "type": "image", "settings": { "image_fallback": "pillowtalk-8.jpg" } }
    ]
  },
  "presets": [
    { "name": "Social gallery" }
  ]
}
{% endschema %}
