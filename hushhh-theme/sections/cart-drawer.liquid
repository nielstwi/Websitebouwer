{% comment %}
  Cart drawer, rendered as a static section (called from layout/theme.liquid via {% section 'cart-drawer' %})
  so it can be re-fetched client-side through the Section Rendering API (/?section_id=cart-drawer)
  every time the cart changes, without a full page reload.
{% endcomment %}
<div class="cart-drawer__overlay" data-cart-drawer-overlay></div>
<div class="cart-drawer" data-cart-drawer data-section-id="cart-drawer" aria-hidden="true">
  <div class="cart-drawer__header">
    <strong>{{ 'cart.general.title' | t }} <span data-cart-count-value hidden>{{ cart.item_count }}</span></strong>
    <button data-cart-drawer-close aria-label="Close cart">&times;</button>
  </div>

  <div class="cart-drawer__items">
    {% if cart.item_count == 0 %}
      <div class="empty-state">
        <p>{{ 'cart.general.empty' | t }}</p>
        <a class="btn btn--outline" href="{{ routes.all_products_collection_url }}" data-cart-drawer-close>{{ 'cart.general.continue_shopping' | t }}</a>
      </div>
    {% else %}
      {% for item in cart.items %}
        <div class="cart-line" data-cart-line="{{ item.key }}">
          <a href="{{ item.url }}"><img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="80" height="96"></a>
          <div class="cart-line__info">
            <div class="cart-line__title"><a href="{{ item.url }}">{{ item.product.title }}</a></div>
            {% unless item.variant.title contains 'Default' %}
              <div class="cart-line__variant">{{ item.variant.title }}</div>
            {% endunless %}
            <div style="display:flex; align-items:center; justify-content:space-between; gap:10px;">
              <span class="cart-line__qty">
                <button data-qty-minus type="button" aria-label="Decrease quantity">&minus;</button>
                <input type="number" min="0" value="{{ item.quantity }}" data-qty-input aria-label="Quantity">
                <button data-qty-plus type="button" aria-label="Increase quantity">&plus;</button>
              </span>
              <span>{{ item.final_line_price | money }}</span>
            </div>
            <button data-cart-remove="{{ item.key }}" class="visually-hidden">{{ 'cart.general.remove' | t }}</button>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>

  {% if cart.item_count > 0 %}
    <div class="cart-drawer__footer">
      {% if settings.cart_show_shipping_bar %}
        {% assign threshold_cents = settings.cart_shipping_threshold | times: 100 %}
        {% assign remaining = threshold_cents | minus: cart.total_price %}
        <div class="cart-shipping-bar">
          {% if remaining > 0 %}
            {{ 'cart.general.free_shipping_progress' | t: amount: remaining | money }}
          {% else %}
            {{ 'cart.general.free_shipping_reached' | t }}
          {% endif %}
          <div class="cart-shipping-bar__track">
            {% assign pct = cart.total_price | times: 100 | divided_by: threshold_cents %}
            {% if pct > 100 %}{% assign pct = 100 %}{% endif %}
            <div class="cart-shipping-bar__fill" style="width: {{ pct }}%;"></div>
          </div>
        </div>
      {% endif %}
      <div class="cart-subtotal">
        <span>{{ 'cart.general.subtotal' | t }}</span>
        <span>{{ cart.total_price | money }}</span>
      </div>
      <a href="{{ routes.cart_url }}" class="btn btn--full">{{ 'cart.general.checkout' | t }}</a>
    </div>
  {% endif %}
</div>

{% schema %}
{ "name": "Cart drawer", "settings": [] }
{% endschema %}
