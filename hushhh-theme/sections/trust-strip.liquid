<div class="trust-strip section-padding">
  <div class="container">
    <div class="trust-strip__grid">
      {% for block in section.blocks %}
        {% if block.type == 'item' %}
          <div class="trust-strip__item" {{ block.shopify_attributes }}>
            <div class="trust-strip__stars">{% for i in (1..5) %}&#9733;{% endfor %}</div>
            <p class="trust-strip__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
            <div class="trust-strip__source">{{ block.settings.source }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust strip",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Rating",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Excellent quality and so soft!" },
        { "type": "text", "id": "source", "label": "Source label", "default": "Verified Buyer" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "quote": "My skin and hair love this pillowcase.", "source": "Verified Buyer" } },
      { "type": "item", "settings": { "quote": "So soft and comfortable, my favourite purchase.", "source": "Verified Buyer" } },
      { "type": "item", "settings": { "quote": "Fast shipping and beautiful packaging.", "source": "Verified Buyer" } },
      { "type": "item", "settings": { "quote": "Worth every penny, will buy again.", "source": "Verified Buyer" } }
    ]
  },
  "presets": [
    { "name": "Trust strip" }
  ]
}
{% endschema %}
